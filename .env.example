# Database URL for Neon Postgres
DATABASE_URL=

# API key for OpenRouter LLM API
OPENROUTER_API_KEY=

# Model ID for demand classification (default: deepseek/deepseek-v4.1-flash)
DEMAND_MODEL=

# Model ID for demand clustering (default: deepseek/deepseek-v4.1-flash)
CLUSTER_MODEL=

# Secret token for /api/cron/ingest endpoint authorization
CRON_SECRET=

# GitHub API token for fetching repository data
GITHUB_TOKEN=

# YouTube API key for querying video data
YOUTUBE_API_KEY=

# API key for demands endpoint access
DEMANDS_API_KEY=

# JSON map of Reddit cookie name -> value, must include reddit_session. Secret.
REDDIT_COOKIES_JSON=
