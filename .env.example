# All optional in local dev — the pipeline degrades gracefully without them.

# Neon Postgres connection string. Without it, data goes to .data/demands.json (dev only).
DATABASE_URL=

# OpenRouter key for the LLM classification stage.
# Without it, candidates are stored unclassified (pass-through).
OPENROUTER_API_KEY=

# Override the classification model (default: google/gemini-3.8-flash).
DEMAND_MODEL=

# Protects /api/cron/ingest in production. Vercel Cron sends it automatically.
CRON_SECRET=

# Optional: raises GitHub search API rate limits.
GITHUB_TOKEN=

# YouTube Data API v3 key for the workaround-tutorial source. Without it, the source is skipped.
YOUTUBE_API_KEY=

# Override the clustering model (default: deepseek/deepseek-v4-flash-0731).
CLUSTER_MODEL=

# Optional bearer token for GET /api/demands (unset = no app-level auth).
DEMANDS_API_KEY=

# Reddit Agent-Reach service (see docs/reddit-agent-reach.md).
# Shared bearer token for the private Python service.
REDDIT_AGENT_REACH_TOKEN=
# JSON cookie name/value map, including reddit_session. Server-side secret.
REDDIT_COOKIES_JSON=
# Local override only; Vercel generates this via a service binding.
REDDIT_AGENT_REACH_URL=
